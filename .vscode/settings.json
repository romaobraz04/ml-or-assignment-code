{
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "latexmk (report)",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (report)",
      "tools": ["latexmk-report"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-report",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.search.rootFiles.include": ["**/report.tex"],
  "latex-workshop.view.pdf.viewer": "tab"
}
